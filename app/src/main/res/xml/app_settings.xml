<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <Preference
        android:key="appInfo"
        android:layout="@layout/preference_app_header" />

    <SwitchPreference
        android:icon="@drawable/outline_shield_24"
        android:key="hideEnabled"
        android:summary="@string/app_enable_off"
        android:title="@string/app_enable_hide" />

    <PreferenceCategory
        android:dependency="hideEnabled"
        android:title="@string/app_hide_options">
        <icu.nullptr.hidemyapplist.ui.preference.WorkModePreference
            android:key="workMode" />
    </PreferenceCategory>

    <PreferenceCategory
        android:dependency="hideEnabled"
        android:key="ruleConfigCategory"
        android:title="@string/app_rule_config_hidden">
        <SwitchPreference
            android:icon="@drawable/baseline_call_split_24"
            android:key="excludeSystemApps"
            android:title="@string/app_exclude_system_apps" />
        <Preference
            android:icon="@drawable/outline_assignment_24"
            android:key="applyTemplates"
            android:title="@string/app_templates" />
        <Preference
            android:icon="@drawable/baseline_apps_24"
            android:key="extraAppList"
            android:title="@string/app_extra_apps_title" />
    </PreferenceCategory>
</PreferenceScreen>
