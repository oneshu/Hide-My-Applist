<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <Preference
        android:key="appInfo"
        android:layout="@layout/preference_app_header" />

    <SwitchPreference
        android:icon="@drawable/outline_shield_24"
        android:key="hideEnabled"
        android:summary="@string/app_enable_off"
        android:title="@string/app_enable_hide" />

    <PreferenceCategory
        android:dependency="hideEnabled"
        android:title="@string/app_mode_section">
        <icu.nullptr.hidemyapplist.ui.preference.WorkModePreference
            android:key="workMode" />
    </PreferenceCategory>

    <PreferenceCategory
        android:dependency="hideEnabled"
        android:key="ruleConfigCategory"
        android:title="@string/app_rule_config_section">
        <SwitchPreference
            android:icon="@drawable/outline_android_24"
            android:key="allowSystemApps"
            android:title="@string/app_allow_system_apps" />
        <Preference
            android:icon="@drawable/outline_assignment_24"
            android:key="templateSource"
            android:title="@string/app_template_entry_title" />
        <Preference
            android:icon="@drawable/baseline_apps_24"
            android:key="appList"
            android:title="@string/app_blacklist_list_title" />
    </PreferenceCategory>
</PreferenceScreen>
